# Cloud generation model
PAPER_AGENT_GLM_API_KEY=replace-with-your-api-key
PAPER_AGENT_GLM_MODEL=glm-4.7

# Local persistence
PAPER_AGENT_DATA_DIR=./data
PAPER_AGENT_DATABASE_PATH=./data/paper_agent.sqlite3
PAPER_AGENT_CHROMA_DIR=./data/chroma

# Local models
PAPER_AGENT_EMBEDDING_MODEL_PATH=E:\00project\02agent\models\bge-large-zh-v1.5
PAPER_AGENT_RERANKER_MODEL_PATH=E:\00project\02agent\models\bge-reranker-v2-m3

# Chunking
PAPER_AGENT_CHILD_CHUNK_MIN_TOKENS=300
PAPER_AGENT_CHILD_CHUNK_MAX_TOKENS=500
PAPER_AGENT_PARENT_CHUNK_MIN_TOKENS=1000
PAPER_AGENT_PARENT_CHUNK_MAX_TOKENS=1500
PAPER_AGENT_FORCED_SPLIT_OVERLAP_RATIO=0.15

# Retrieval and context
PAPER_AGENT_RETRIEVAL_CANDIDATE_LIMIT=50
PAPER_AGENT_RERANK_RESULT_LIMIT=12
PAPER_AGENT_EVIDENCE_CONTEXT_RATIO=0.50

# Runtime
PAPER_AGENT_LOG_LEVEL=INFO
